# Copy to .env.local and fill in values. .env.local is gitignored.

# Local dev uses docker-compose networking, so these are overridden
# in docker-compose.yml environment block.
# This file is for running api/ outside docker (e.g. `uvicorn app.main:app` directly).

ENVIRONMENT=local
LOG_LEVEL=DEBUG

# DB — per-module DSNs (local dev)
DB_IDENTITY_DSN=postgresql+asyncpg://rithm_identity:dev_identity_pw@localhost:5433/rithm-db
DB_CATALOG_DSN=postgresql+asyncpg://rithm_catalog:dev_catalog_pw@localhost:5433/rithm-db
DB_GENERATION_DSN=postgresql+asyncpg://rithm_generation:dev_generation_pw@localhost:5433/rithm-db
DB_CONVERSATION_DSN=postgresql+asyncpg://rithm_conversation:dev_conversation_pw@localhost:5433/rithm-db
DB_PERSONALIZATION_DSN=postgresql+asyncpg://rithm_personalization:dev_personalization_pw@localhost:5433/rithm-db

# AWS (LocalStack for local dev)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
ASSETS_BUCKET=rithm-assets-local
SQS_JOBS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/rithm-generation-jobs
SNS_COMPLETIONS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:rithm-job-completions

# Cognito (use real dev pool even in local dev — LocalStack Cognito coverage is incomplete)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Operational
SSE_TOKEN_SECRET=local-dev-secret-not-for-prod
# Lifetime of the signed token in the SSE stream URL. 1800, not 300: a cold
# start is minutes, so a 5-minute token can be outlived by the very first
# generation of a session — and the failure (one reconnect after a wifi blip
# 401s permanently) cannot reproduce locally, because local has no cold start.
SSE_TOKEN_TTL_SECONDS=1800
CURRENT_CONSENT_VERSION=tos-2026-05

# Browser origins allowed to call this API cross-origin, comma-separated.
# EXISTS ONLY FOR `npm run dev`. Production is same-origin — CloudFront serves
# the SPA at / and proxies /api/* to the ALB — so the prod taskdef needs no
# value here at all. Never a wildcard: with allow_credentials a browser refuses
# "*", so it breaks silently rather than loosening anything.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Generation budget guard. 20 per rolling 24h per user, counted over
# QUEUED/RUNNING/COMPLETED — a failed job did not consume a generation.
RATE_LIMIT_PER_24H=20
# API-side length ceiling, mirroring the worker's. Lower it from the PoC's
# findings without redeploying.
MAX_LENGTH_SECONDS=180

# Stuck-job sweeper. Set SWEEPER_ENABLED=false in tests and anywhere you do not
# want a background DB task.
SWEEPER_ENABLED=true
SWEEPER_INTERVAL_SECONDS=300
STUCK_RUNNING_SECONDS=600
# MUST exceed cold start + queue wait + max generation, and it is a floor:
# lower it and the sweeper fails healthy jobs while capacity is still booting.
# 1800 was sized against a >12 GB GPU worker image. The worker is now ~250 MB
# and calls ACE-Step over HTTP, but that server's own start-up moved into the
# same window and is unmeasured — keep 1800 until J4 gives a real number.
STUCK_QUEUED_SECONDS=1800

# What the `queued` SSE frame advertises so a cold start does not read as hung.
# Tri sets the real number from the Gate D baseline. Expect it to come DOWN
# sharply now the worker no longer pulls a CUDA image — measure, do not guess.
ESTIMATED_COLD_START_SECONDS=300

# Dev-only routes (/internal/dev/enqueue-test-job). MUST be absent or 0
# in the production ECS task definition.
RITHM_DEV_ENDPOINTS=1
