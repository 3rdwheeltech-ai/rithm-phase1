{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ECRPush",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:685448855132:repository/rithm/api",
        "arn:aws:ecr:us-east-1:685448855132:repository/rithm/worker"
      ]
    },
    {
      "Sid": "ECSTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ECSRunMigrations",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-1:685448855132:task-definition/rithm-api-migrations:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:us-east-1:685448855132:cluster/rithm-prod"
        }
      }
    },
    {
      "Sid": "ECSWatchTasks",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:us-east-1:685448855132:task/rithm-prod/*"
    },
    {
      "Sid": "ECSService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": [
        "arn:aws:ecs:us-east-1:685448855132:service/rithm-prod/rithm-api-service-pqqbkv2h",
        "arn:aws:ecs:us-east-1:685448855132:service/rithm-prod/rithm-worker-fg",
        "arn:aws:ecs:us-east-1:685448855132:service/rithm-prod/rithm-worker-service"
      ]
    },
    {
      "Sid": "PassTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::685448855132:role/ecsTaskExecutionRole",
        "arn:aws:iam::685448855132:role/rithm-api-task-role",
        "arn:aws:iam::685448855132:role/rithm-worker-task-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "WebBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::rithm-web-prod-685448855132"
    },
    {
      "Sid": "WebBucketWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::rithm-web-prod-685448855132/*"
    },
    {
      "Sid": "CloudFrontInvalidate",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::685448855132:distribution/E229B83P0XRWUL"
    }
  ]
}
