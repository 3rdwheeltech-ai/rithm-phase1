# Copy to .env and fill in values. .env is gitignored.
# Worker runs on ECS in prod. It is CPU-only in both modes — the GPU belongs to
# the ACE-Step server it talks to, not to this process. These values are for
# local runs against docker-compose + LocalStack.

ENVIRONMENT=local
LOG_LEVEL=DEBUG

# The worker is SYNCHRONOUS: this is a psycopg2 DSN, not the API's +asyncpg one.
# Do not cross them. Against RDS, append ?sslmode=require — psycopg2 reads SSL
# from the URL, unlike asyncpg's ssl= connect-arg.
# Database name is `rithm-db` on host port 5433, matching docker-compose.yml.
# It was `rithm-dev` until 2026-08-03; the local database and the RDS instance
# are both `rithm-db` now, so the two no longer disagree. `rithm-dev` still
# names the Cognito pool and the AWS CLI profile — those are unrelated and
# unchanged.
DB_GENERATION_DSN_SYNC=postgresql://rithm_generation:dev_generation_pw@localhost:5433/rithm-db

AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
ASSETS_BUCKET=rithm-assets-local
SQS_JOBS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/rithm-generation-jobs

# Inference. 1 = copy the canned fixture instead of calling ACE-Step, which is
# what Gates C and D run with. For a real worker the variable must be REMOVED,
# not set to 0 — a leftover 1 means every check goes green while producing
# nothing real.
RITHM_STUB_INFERENCE=1

# ACE-Step v1.5 is an HTTP server, not a Python import: the worker holds no
# model, needs no GPU and bakes no weights. Point this at the server — a sidecar
# on localhost, or a standalone box. Empty is what tells inference.py it is not
# configured yet; with the stub flag off and this unset, model load refuses
# loudly at boot with a message naming the variable.
ACESTEP_API_BASE=

# The one /release_task field the PoC did not pin down. Environment-settable on
# purpose: a wrong value is a taskdef edit, not a rebuild.
ACESTEP_TASK_TYPE=text2music
# Only variant the PoC exercised. Empty omits the field and takes the server's
# default. No non-turbo quality comparison has been made.
ACESTEP_DIT_MODEL=acestep-v15-turbo
# The PoC could NOT confirm that /release_task accepts a seed — seed_value comes
# back in generation_info, but forcing one client-side is unverified. Off by
# default because an unknown field risks a 422 on every job. Turn it on once the
# field name is confirmed and variations become reproducible instead of merely
# different.
ACESTEP_SEND_SEED=0

# Per-HTTP-call ceiling. NOT the generation budget — that is the pair below.
ACESTEP_HTTP_TIMEOUT_SECONDS=30
ACESTEP_POLL_INTERVAL_SECONDS=2
# Generation wall-clock is two components, not one: the LM planning phase is
# roughly flat (6-14s measured) and DiT synthesis scales with duration
# (~2.4s@30s, 3.7s@90s, 6.8s@180s). So the deadline is base + slope*duration.
# These give 150s for a 30s track and 300s for a 180s one.
ACESTEP_POLL_TIMEOUT_BASE_SECONDS=120
ACESTEP_POLL_TIMEOUT_PER_LENGTH_SECOND=1
ACESTEP_SUBMIT_ATTEMPTS=3

# The worker's own length ceiling, mirroring the API's cap so an over-long job
# is refused with a message instead of tying up the model server. PoC intake #9
# confirmed 180s is comfortable (18.4/23 GB peak, no OOM). Untested above that.
MAX_LENGTH_SECONDS=180

# Overrides the queue's own 300s default at receive time. The GPU taskdef sets
# 900: a real generation plus warm-up plus post-processing plus a ~60MB upload
# can exceed 300, and when it does SQS redelivers a job that is still running.
SQS_VISIBILITY_TIMEOUT_SECONDS=300

# Seconds of empty long-polls before the task exits so the ASG can scale to
# zero. 0 disables it — required for the Fargate stub service, which has no
# capacity provider to replace an exited task, and for Gate D so the box holds
# still while you SSM into it. The real GPU service runs 600.
WORKER_IDLE_EXIT_SECONDS=0

# NOTE: SNS_COMPLETIONS_TOPIC_ARN is deliberately absent. The worker publishes
# to the callback_topic_arn carried in each job envelope, never a configured
# ARN — that is what the task role scopes and what keeps the image
# environment-agnostic.
